# Copy to .envrc.secrets and fill in. .envrc.secrets is gitignored; this example is not.
# Loaded by direnv via .envrc (run `direnv allow` once).

# Auth0 client secret for the Done Manager (dev) application in the
# dewet-dev.us.auth0.com tenant. Required to boot in dev (config/runtime.exs).
export AUTH0_CLIENT_SECRET="your-dev-client-secret"

# Optional: overrides the client_id placeholder in config/dev.exs.
# export AUTH0_CLIENT_ID="your-dev-client-id"
